# TrustMotion Agency environment contract
# Copy to .env.local for development. Never commit .env.local or real secrets.
# Public values are bundled into browser code only when prefixed NEXT_PUBLIC_.

# Build-time, browser-visible
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SANITY_PROJECT_ID=replace-with-development-project-id
NEXT_PUBLIC_SANITY_DATASET=development
NEXT_PUBLIC_ANALYTICS_CONSENT_MODE=opt-in
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=

# Build/runtime, server-only unless noted
SANITY_API_VERSION=2025-01-01
SANITY_READ_TOKEN=replace-with-development-read-token
SANITY_PREVIEW_TOKEN=replace-with-development-preview-token
PREVIEW_SECRET=replace-with-a-random-32-byte-development-secret
RESEND_API_KEY=re_test_replace-me
INQUIRY_TO_EMAIL=test-inbox@example.test
INQUIRY_FROM_EMAIL=TrustMotion <noreply@example.test>
CALCOM_BOOKING_URL=https://cal.example.test/trustmotion
LEAD_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_SALT=replace-with-a-random-development-salt

# SANITY_REVALIDATE_SECRET is intentionally not supported in this MVP.
# Legacy aliases (SANITY_API_READ_TOKEN, SANITY_PREVIEW_SECRET,
# INQUIRY_DESTINATION_EMAIL, RESEND_FROM_EMAIL, ALLOWED_ORIGINS) are rejected.
