{
  "env": {
    "es2022": true,
    "node": true
  },
  "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended"],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "plugins": ["@typescript-eslint"],
  "ignorePatterns": [
    ".next/",
    "coverage/",
    "artifacts/",
    "test-results/",
    "next-env.d.ts"
  ],
  "rules": {
    "no-control-regex": "off"
  }
}
