{
  "name": "trustmotion-agency",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint . --ext .js,.mjs,.ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check app tests scripts next.config.ts tsconfig.json package.json .eslintrc.json .github/workflows/ci.yml",
    "test": "vitest run",
    "test:e2e": "playwright test tests/e2e",
    "test:a11y": "playwright test tests/a11y",
    "lighthouse": "lighthouse http://127.0.0.1:3000 --output=json --output-path=artifacts/lighthouse.json --chrome-flags=\"--headless --no-sandbox\"",
    "check:bundle": "node scripts/check-bundle.mjs",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:audit": "pnpm audit --audit-level=high",
    "ci:evidence": "node scripts/write-ci-evidence.mjs",
    "build": "next build"
  },
  "dependencies": {
    "next": "15.5.27",
    "postcss": "8.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "0.35.5"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.28",
      "braces": "3.0.3"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "22.13.4",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "8.57.1",
    "lighthouse": "13.5.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "vitest": "3.2.6"
  }
}
